/* ── GLITCH CODE ── */
.error-code-wrap {
  position: relative;
  display: inline-block;
  margin-bottom: 1.5rem;
}
.error-code {
  font-family: 'Syne', sans-serif;
  font-size: clamp(7rem, 20vw, 14rem);
  font-weight: 800;
  line-height: 1;
  letter-spacing: -0.06em;
  background: linear-gradient(135deg, #3b82f6, #6366f1, #22d3ee);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  position: relative;
  animation: glitch 4s infinite;
  filter: drop-shadow(0 0 60px rgba(59,130,246,0.25));
}
.error-code::before,
.error-code::after {
  content: attr(data-text);
  position: absolute;
  top: 0; left: 0; width: 100%;
  background: linear-gradient(135deg, #3b82f6, #6366f1, #22d3ee);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.error-code::before {
  animation: glitch-r 4s infinite;
  clip-path: polygon(0 20%, 100% 20%, 100% 40%, 0 40%);
  transform: translate(-4px, 0);
  opacity: 0.6;
  filter: hue-rotate(20deg);
}
.error-code::after {
  animation: glitch-b 4s 0.1s infinite;
  clip-path: polygon(0 60%, 100% 60%, 100% 80%, 0 80%);
  transform: translate(4px, 0);
  opacity: 0.6;
  filter: hue-rotate(-20deg);
}
@keyframes glitch {
  0%,85%,100%{transform:translate(0);}
  87%{transform:translate(-3px,1px);}
  89%{transform:translate(3px,-1px);}
  91%{transform:translate(-1px,0);}
  93%{transform:translate(1px,2px);}
  95%{transform:translate(0);}
}
@keyframes glitch-r {
  0%,85%,100%{transform:translate(-4px,0);opacity:0.6;}
  87%{transform:translate(4px,-2px);opacity:0.8;}
  89%{transform:translate(-4px,2px);opacity:0.4;}
  91%{transform:translate(0);opacity:0.6;}
}
@keyframes glitch-b {
  0%,85%,100%{transform:translate(4px,0);opacity:0.6;}
  87%{transform:translate(-4px,2px);opacity:0.4;}
  89%{transform:translate(4px,-1px);opacity:0.8;}
  91%{transform:translate(0);opacity:0.6;}
}
.error-scan-lines {
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    0deg, transparent, transparent 3px,
    rgba(59,130,246,0.02) 3px, rgba(59,130,246,0.02) 4px
  );
  pointer-events: none;
  animation: scan 8s linear infinite;
}
@keyframes scan {
  0%{background-position:0 0;}
  100%{background-position:0 100px;}
}

