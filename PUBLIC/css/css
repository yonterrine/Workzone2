/* ═══════════════════════════════
   HERO
═══════════════════════════════ */
.hero-section {
  min-height: 90vh;
  display: flex;
  align-items: center;
  padding: 5rem 0 4rem;
  position: relative;
  overflow: hidden;
}
.hero-line {
  position: absolute;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(99,102,241,0.3), transparent);
  pointer-events: none;
}
.hero-line-1 { width:80%; left:10%; top:20%; }
.hero-line-2 { width:60%; left:20%; bottom:25%; opacity:0.5; }

.hero-inner {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 4rem;
  align-items: center;
}

.hero-glow-card {
  background: rgba(17,24,39,0.6);
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 3rem 3.5rem;
  backdrop-filter: blur(20px);
  box-shadow:
    0 8px 40px rgba(0,0,0,0.5),
    0 0 0 1px rgba(99,102,241,0.06),
    inset 0 1px 0 rgba(255,255,255,0.04);
  transition: all 0.45s cubic-bezier(0.23,1,0.32,1);
  position: relative;
}
.hero-glow-card:hover {
  transform: translateY(-6px);
  border-color: rgba(99,102,241,0.4);
  box-shadow:
    0 28px 72px rgba(0,0,0,0.6),
    0 0 80px rgba(59,130,246,0.12),
    0 0 0 1px rgba(99,102,241,0.2),
    inset 0 1px 0 rgba(255,255,255,0.07);
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(34,211,238,0.08);
  border: 1px solid rgba(34,211,238,0.2);
  border-radius: 999px;
  padding: 0.35rem 1rem;
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--accent3);
  letter-spacing: 0.04em;
  margin-bottom: 1.5rem;
}
.badge-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: var(--accent3);
  animation: blink 1.5s infinite;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }

.hero-headline {
  font-family: 'Syne', sans-serif;
  font-size: clamp(2.5rem, 5.5vw, 4.2rem);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.045em;
  margin-bottom: 1.1rem;
}
.gradient-text {
  background: linear-gradient(135deg, var(--accent), var(--accent2), var(--accent3));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.hero-sub-word {
  font-size: 0.75em;
  color: var(--muted);
  -webkit-text-fill-color: var(--muted);
  display: block;
  font-weight: 600;
  margin-top: 0.2rem;
}

.hero-desc {
  color: var(--muted);
  font-size: 1.05rem;
  line-height: 1.7;
  margin-bottom: 2rem;
  max-width: 500px;
}

/* Search bar */
.search-bar {
  display: flex;
  align-items: center;
  gap: 0;
  border: 1px solid var(--border2);
  border-radius: 14px;
  overflow: hidden;
  background: rgba(7,9,15,0.8);
  box-shadow: 0 0 0 4px rgba(59,130,246,0.06), 0 4px 20px rgba(0,0,0,0.4);
  transition: box-shadow 0.3s;
  margin-bottom: 1rem;
}
.search-bar:focus-within {
  box-shadow: 0 0 0 3px rgba(59,130,246,0.3), 0 4px 20px rgba(0,0,0,0.4);
  border-color: var(--accent);
}
.search-icon { padding: 0 0.75rem 0 1.1rem; font-size: 1rem; }
.search-bar input {
  flex: 1;
  padding: 0.9rem 0.5rem;
  background: transparent;
  border: none;
  color: var(--text);
  font-family: 'DM Sans', sans-serif;
  font-size: 0.95rem;
  outline: none;
  min-width: 0;
}
.search-bar input::placeholder { color: var(--muted); }
.search-bar select {
  padding: 0.9rem 0.8rem;
  background: rgba(17,24,39,0.9);
  border: none;
  border-left: 1px solid var(--border);
  color: var(--muted);
  font-family: 'DM Sans', sans-serif;
  font-size: 0.875rem;
  outline: none;
  cursor: pointer;
}
.search-bar select option { background: var(--bg3); }
.search-bar .btn { border-radius: 0; margin: 0; padding: 0.9rem 1.4rem; }

.popular-searches {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
